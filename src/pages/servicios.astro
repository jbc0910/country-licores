---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import barInteriorImg from "../assets/bar-interior.jpg";
---

<Layout
  title="Servicios de Bar y Reservas en Barranquilla | Country Licores"
  description="Reservas de mesa, paquetes de cumpleaños y eventos grupales en Country Licores Barranquilla. Más de 20 años de trayectoria. Carrera 43B #82-19. Llámanos: 324 303 7861."
  canonical="https://countrylicores.com/servicios"
>
  <!-- Page Hero -->
  <section
    class="bg-nocturno-bg pt-10 md:pt-16 pb-16 md:pb-24"
    style="
    position:relative;
    overflow:hidden;
  "
  >
    <div
      style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:800px; height:400px; background:radial-gradient(ellipse, rgba(92,14,26,0.12) 0%, transparent 70%); pointer-events:none;"
    >
    </div>
    <div class="container" style="position:relative; text-align:center;">
      <p class="section-eyebrow" style="justify-content:center;">
        Lo que hacemos
      </p>
      <h1
        class="font-display"
        style="font-size:clamp(2.2rem, 5vw, 4rem); font-weight:900; color:#FFFFFF; margin-top:0.5rem; margin-bottom:1rem; line-height:1.1;"
      >
        Nuestros <span class="vinotinto-text-gradient">Servicios</span>
      </h1>
      <p
        style="color:#999999; max-width:560px; margin:0 auto; font-size:1rem; line-height:1.75;"
      >
        Desde una salida de amigos hasta el evento más especial del año. Cada
        servicio está pensado para que vivas la mejor parranda de tu vida.
      </p>
    </div>
  </section>

  <!-- ========================================
       PROBLEMA
       ======================================== -->
  <section class="bg-nocturno-bg py-12 md:py-24">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div class="reveal-left">
          <p class="section-eyebrow">El problema real</p>
          <h2
            class="font-display"
            style="font-size:clamp(1.8rem, 3.5vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem; margin-bottom:1.25rem; line-height:1.2;"
          >
            ¿Cansado de llegar<br />
            <span class="vinotinto-text-gradient">y no encontrar espacio?</span>
          </h2>
          <p
            class="text-neutral-300"
            style="font-size:0.95rem; line-height:1.8; margin-bottom:1rem;"
          >
            Planeas tu noche con ilusión?
          </p>
          <ul
            style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;"
          >
            {
              [
                "Sin reserva, sin garantía de mesa",
                "Eventos sin planificación = caos",
                "Cumpleaños sin personalización = mediocridad",
                "Pagar de más sin saber qué incluye",
              ].map((item) => (
                <li class="text-neutral-300" style="display:flex; align-items:flex-start; gap:0.75rem; font-size:0.9rem;">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-vinotinto-light)"
                    stroke-width="2"
                    style="flex-shrink:0; margin-top:2px;"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <line x1="15" y1="9" x2="9" y2="15" />
                      <line x1="9" y1="9" x2="15" y2="15" />
                    </>
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal-right img-overlay" style="aspect-ratio:4/3;">
          <Image
            src={barInteriorImg}
            alt="Interior de Country Licores Barranquilla de noche"
            title="Ambiente nocturno Country Licores"
            loading="lazy"
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 600px"
            style="width:100%; height:100%; object-fit:cover;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       SOLUCIÓN
       ======================================== -->
  <section
    class="bg-nocturno-bg py-12 md:py-24"
    style="border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div class="container">
      <div class="reveal section-header" style="text-align:center;">
        <p class="section-eyebrow" style="justify-content:center;">
          La solución
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem; margin-bottom:1rem;"
        >
          Country Licores resuelve<br />
          <span class="vinotinto-text-gradient">todo por ti</span>
        </h2>
        <p
          class="text-neutral-300"
          style="max-width:540px; margin:0 auto; font-size:1rem; line-height:1.75;"
        >
          Un mensaje por WhatsApp y tu noche está asegurada. Así de simple. Así
          de Country.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          [
            {
              icon: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
              title: "Reserva de Mesa",
              desc: "Reserva tu mesa en nuestra sede principal. Confirma el día, la hora y el número de personas. Llegás y tu espacio está listo.",
              tag: "Disponible todos los días",
            },
            {
              icon: `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
              title: "Paquete Cumpleaños",
              desc: "Celebra con todo. Mesa decorada, licor incluido, picadas y una atención que hace sentir especial al cumpleañero o cumpleañera.",
              tag: "El más solicitado",
            },
            {
              icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
              title: "Eventos Grupales",
              desc: "Para despedidas, salidas de empresa o reuniones de amigos. Armamos el plan para tu grupo, sea de 5 o 50 personas.",
              tag: "A la medida",
            },
          ].map((service) => (
            <div class="card-dark reveal" style="padding:2.25rem;">
              <div style="display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px; border:1px solid var(--color-vinotinto-light); margin-bottom:1.5rem;">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-vinotinto-light)"
                  stroke-width="1.5"
                  set:html={service.icon}
                />
              </div>
              <span class="bg-vinotinto/10 text-vinotinto-light border-vinotinto-light/30" style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; padding:0.2rem 0.6rem; border:1px solid; display:inline-block; margin-bottom:1rem;">
                {service.tag}
              </span>
              <h3
                class="font-display"
                style="font-size:1.25rem; font-weight:700; color:#FFFFFF; margin-bottom:0.75rem;"
              >
                {service.title}
              </h3>
              <p class="text-neutral-300" style="font-size:0.9rem; line-height:1.75;">
                {service.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================
       BENEFICIOS
       ======================================== -->
  <section
    class="bg-nocturno-bg py-12 md:py-24"
    style="border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div class="container">
      <div class="reveal section-header" style="text-align:center;">
        <p class="section-eyebrow" style="justify-content:center;">
          Por qué funciona
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem;"
        >
          Los beneficios de reservar<br />
          <span class="vinotinto-text-gradient">con nosotros</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              num: "01",
              title: "Tu noche garantizada",
              desc: "No llegás a improvisar. Tu mesa, tu espacio, tu noche.",
            },
            {
              num: "02",
              title: "Atención personalizada",
              desc: "Te respondemos rápido. Ninguna duda queda sin resolver.",
            },
            {
              num: "03",
              title: "Ubicación exclusiva",
              desc: "Nuestra sede en el sector de la Calle 82 cuenta con excelente ambiente y fácil acceso.",
            },
            {
              num: "04",
              title: "Paquetes claros",
              desc: "Sin letras pequeñas. Sabés exactamente qué incluye tu reserva.",
            },
            {
              num: "05",
              title: "Ambiente de verdad",
              desc: "Parranda vallenata auténtica, no una copia de club genérico.",
            },
            {
              num: "06",
              title: "Precio justo",
              desc: "Calidad que se siente sin que el bolsillo sufra.",
            },
          ].map((b) => (
            <div
              class="reveal-scale p-7 border border-neutral-800 hover:border-vinotinto-light bg-nocturno-card relative transition-colors duration-300"
            >
              <div
                class="font-accent"
                style="font-size:2.5rem; color:rgba(125,20,36,0.25); line-height:1; margin-bottom:0.5rem;"
              >
                {b.num}
              </div>
              <h3 style="font-size:0.95rem; font-weight:700; color:#FFFFFF; margin-bottom:0.5rem;">
                {b.title}
              </h3>
              <p class="text-neutral-300" style="font-size:0.85rem; line-height:1.7;">
                {b.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================
       PROCESO
       ======================================== -->
  <section
    class="bg-nocturno-bg py-12 md:py-24"
    style="border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div class="container">
      <div class="reveal section-header" style="text-align:center;">
        <p class="section-eyebrow" style="justify-content:center;">
          Así de fácil
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem;"
        >
          Tu reserva en<br />
          <span class="vinotinto-text-gradient">3 pasos</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-0 relative">
        {
          [
            {
              step: "1",
              title: "Escríbenos",
              desc: "Envíanos un mensaje por WhatsApp con el día, hora, sede y número de personas. En minutos te respondemos.",
              icon: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
            },
            {
              step: "2",
              title: "Confirmamos",
              desc: "Te confirmamos disponibilidad y los detalles del paquete. Acordamos todo sin complicaciones.",
              icon: `<polyline points="20 6 9 17 4 12"/>`,
            },
            {
              step: "3",
              title: "Llegás y disfrutás",
              desc: "Tu mesa está lista. Llegás, te acomodás y empieza la parranda. Así de simple.",
              icon: `<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>`,
            },
          ].map((step, i) => (
            <div
              class="reveal"
              style="padding:2.5rem; position:relative; border:1px solid rgba(255,255,255,0.05); border-right:none; background:var(--color-nocturno-card);"
            >
              <div
                style={`
              position:absolute;
              top:2.5rem;
              right:-1px;
              width:2px;
              height:40%;
              background:linear-gradient(to bottom, rgba(125,20,36,0.4), transparent);
              display: ${i < 2 ? 'block' : 'none'};
            `}
              />
              <div
                style="
              width:64px;
              height:64px;
              border:1px solid var(--color-vinotinto-light);
              display:flex;
              align-items:center;
              justify-content:center;
              margin-bottom:1.5rem;
              position:relative;
            "
              >
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-vinotinto-light)"
                  stroke-width="1.5"
                  set:html={step.icon}
                />
                <span
                  style="
                position:absolute;
                top:-10px;
                right:-10px;
                width:24px;
                height:24px;
                background:var(--color-vinotinto-light);
                color:#FFFFFF;
                font-size:0.7rem;
                font-weight:900;
                display:flex;
                align-items:center;
                justify-content:center;
              "
                >
                  {step.step}
                </span>
              </div>
              <h3 style="font-size:1.15rem; font-weight:700; color:#FFFFFF; margin-bottom:0.75rem;">
                {step.title}
              </h3>
              <p class="text-neutral-300" style="font-size:0.9rem; line-height:1.75;">
                {step.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================
       CTA FINAL
       ======================================== -->
  <section
    class="bg-nocturno-bg py-16 md:py-28"
    style="text-align:center; position:relative; overflow:hidden; border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div
      style="position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(92,14,26,0.1) 0%, transparent 65%); pointer-events:none;"
    >
    </div>
    <div class="container" style="position:relative;">
      <div class="reveal">
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 3rem); font-weight:900; color:#FFFFFF; margin-bottom:1rem; line-height:1.1;"
        >
          ¿Listo para tu próxima<br />
          <span class="vinotinto-text-gradient">noche en Country?</span>
        </h2>
        <p
          class="text-neutral-300"
          style="max-width:440px; margin:0 auto 2.5rem; font-size:1rem; line-height:1.75;"
        >
          Un mensaje es todo lo que necesitas. Te atendemos rápido y tu noche
          queda asegurada.
        </p>
        <a
          href="/contacto"
          title="Reservar en Country Licores vía WhatsApp"
          target="_blank"
          rel="noopener"
          class="btn-primary"
          style="font-size:1rem; padding:1.1rem 2.8rem;"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          <span>Reservar por WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
