---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/imagenes/og-image.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="es_CO" />
    <meta property="og:site_name"   content="Country Licores" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logos/favicon.svg" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BarOrPub",
        "name": "Country Licores",
        "description": "Bar de rumba vallenata y crossover en Barranquilla con más de 20 años de trayectoria. El lugar donde el vallenato se siente.",
        "url": "https://countrylicores.com",
        "telephone": "+573243037861",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Carrera 43B #82-19",
          "addressLocality": "Barranquilla",
          "addressRegion": "Atlántico",
          "addressCountry": "CO"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "opens": "16:00",
          "closes": "03:30"
        },
        "servesCuisine": "Bar",
        "priceRange": "$$",
        "sameAs": ["https://www.instagram.com/countrylicores"]
      }
    </script>
  </head>
  <body>
    <!-- Navbar -->
    <nav id="navbar" class="navbar" role="navigation" aria-label="Navegación principal">
      <div class="container">
        <div style="display:flex; align-items:center; justify-content:space-between;">

          <!-- Logo -->
          <a href="/" title="Country Licores - Inicio" style="display:flex; align-items:center; gap:0.75rem;">
            <div style="
              width:42px; height:42px;
              background:linear-gradient(135deg,#7B1828,#5A0F1A);
              clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
              display:flex; align-items:center; justify-content:center;
              font-family:var(--font-accent); font-size:1.1rem; color:#C9A84C; font-weight:900;
            ">CL</div>
            <div>
              <div style="font-family:var(--font-accent); font-size:1.4rem; letter-spacing:0.1em; color:#F8F4EF; line-height:1;">COUNTRY</div>
              <div style="font-family:var(--font-body); font-size:0.6rem; letter-spacing:0.3em; color:#C9A84C; text-transform:uppercase;">LICORES</div>
            </div>
          </a>

          <!-- Desktop Nav -->
          <div id="desktop-nav" class="hidden md:flex items-center gap-6 lg:gap-10">
            <a href="/"          class="nav-link" title="Inicio">Inicio</a>
            <a href="/servicios" class="nav-link" title="Nuestros Servicios">Servicios</a>
            <a href="/nosotros"  class="nav-link" title="Quiénes Somos">Nosotros</a>
            <a href="/casos"     class="nav-link" title="Experiencias">Experiencias</a>
            <a href="/contacto"  class="nav-link" title="Contacto">Contacto</a>
            <a
              href="/contacto"
              title="Reserva tu mesa en Country Licores vía WhatsApp"
              target="_blank"
              rel="noopener"
              class="btn-primary"
              style="padding:0.6rem 1.4rem; font-size:0.75rem;"
            >
              <span>Reservar Mesa</span>
            </a>
          </div>

          <!-- Hamburger -->
          <button
            id="menu-toggle"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            class="flex md:hidden flex-col gap-[5px] bg-transparent border-none cursor-pointer p-1"
          >
            <span style="display:block; width:24px; height:2px; background:#C9A84C; transition:all 0.3s ease;"></span>
            <span style="display:block; width:18px; height:2px; background:#C9A84C; transition:all 0.3s ease;"></span>
            <span style="display:block; width:24px; height:2px; background:#C9A84C; transition:all 0.3s ease;"></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Menú móvil">
      <a href="/"          class="nav-link" title="Inicio"        onclick="closeMobileMenu()">Inicio</a>
      <a href="/servicios" class="nav-link" title="Servicios"     onclick="closeMobileMenu()">Servicios</a>
      <a href="/nosotros"  class="nav-link" title="Nosotros"      onclick="closeMobileMenu()">Nosotros</a>
      <a href="/casos"     class="nav-link" title="Experiencias"  onclick="closeMobileMenu()">Experiencias</a>
      <a href="/contacto"  class="nav-link" title="Contacto"      onclick="closeMobileMenu()">Contacto</a>
      <a
        href="/contacto"
        title="Reservar mesa vía WhatsApp"
        target="_blank"
        rel="noopener"
        class="btn-primary"
        style="margin-top:1rem;"
      ><span>Reservar Mesa</span></a>
    </div>

    <!-- Main Content -->
    <main><slot /></main>

    <!-- Footer -->
    <footer style="background:#060104; border-top:1px solid rgba(201,168,76,0.12); padding:4rem 0 2rem;">
      <div class="container">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">

          <!-- Brand -->
          <div>
            <div style="font-family:var(--font-accent); font-size:1.8rem; letter-spacing:0.1em; color:#F8F4EF; margin-bottom:0.25rem;">COUNTRY LICORES</div>
            <div style="font-size:0.75rem; letter-spacing:0.3em; color:#C9A84C; text-transform:uppercase; margin-bottom:1.25rem;">Donde el vallenato se siente</div>
            <p style="color:#C8BFB0; font-size:0.9rem; line-height:1.7; max-width:260px;">
              Más de 20 años siendo el punto de encuentro de Barranquilla para vivir la parranda vallenata con sabor costeño auténtico.
            </p>
          </div>

          <!-- Sede -->
          <div>
            <h3 style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A84C; margin-bottom:1.25rem;">Nuestra Sede</h3>
            <div style="color:#C8BFB0; font-size:0.9rem; line-height:1.8;">
              <p style="font-weight:600; color:#F8F4EF; margin-bottom:0.25rem;">Sede Principal</p>
              <p>Carrera 43B #82-19</p>
              <p>Barranquilla, Colombia</p>
            </div>
          </div>

          <!-- Horario -->
          <div>
            <h3 style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A84C; margin-bottom:1.25rem;">Horario</h3>
            <div style="color:#C8BFB0; font-size:0.9rem; line-height:1.8;">
              <p>Lunes a Domingo</p>
              <p style="color:#F8F4EF; font-weight:600;">4:00 p.m. — 3:30 a.m.</p>
            </div>
            <div style="margin-top:1.5rem;">
              <h3 style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A84C; margin-bottom:1rem;">Reservas</h3>
              <a
                href="/contacto"
                title="Reserva vía WhatsApp"
                target="_blank"
                rel="noopener"
                style="color:#C9A84C; font-weight:600; font-size:0.95rem;"
              >+57 324 303 7861</a>
            </div>
          </div>

          <!-- Links -->
          <div>
            <h3 style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A84C; margin-bottom:1.25rem;">Navegación</h3>
            <ul style="list-style:none; display:flex; flex-direction:column; gap:0.75rem;">
              <li><a href="/"          title="Inicio"        style="color:#C8BFB0; font-size:0.9rem; transition:color 0.3s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='#C8BFB0'">Inicio</a></li>
              <li><a href="/servicios" title="Servicios"     style="color:#C8BFB0; font-size:0.9rem; transition:color 0.3s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='#C8BFB0'">Servicios</a></li>
              <li><a href="/nosotros"  title="Nosotros"      style="color:#C8BFB0; font-size:0.9rem; transition:color 0.3s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='#C8BFB0'">Nosotros</a></li>
              <li><a href="/casos"     title="Experiencias"  style="color:#C8BFB0; font-size:0.9rem; transition:color 0.3s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='#C8BFB0'">Experiencias</a></li>
              <li><a href="/contacto"  title="Contacto"      style="color:#C8BFB0; font-size:0.9rem; transition:color 0.3s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='#C8BFB0'">Contacto</a></li>
            </ul>
          </div>
        </div>

        <div class="divider" style="margin-bottom:1.5rem;"></div>

        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:1rem;">
          <p style="color:#C8BFB0; font-size:0.8rem;">
            &copy; {new Date().getFullYear()} Country Licores. Todos los derechos reservados.
          </p>
          <a
            href="https://www.instagram.com/countrylicores"
            title="Country Licores en Instagram"
            target="_blank"
            rel="noopener"
            style="display:flex; align-items:center; gap:0.5rem; color:#C8BFB0; font-size:0.8rem; transition:color 0.3s ease;"
            onmouseover="this.style.color='#C9A84C'"
            onmouseout="this.style.color='#C8BFB0'"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @countrylicores
          </a>
        </div>
      </div>
    </footer>

    <!-- GSAP Scripts -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // Navbar scroll
      const navbar = document.getElementById('navbar');
      window.addEventListener('scroll', () => {
        navbar?.classList.toggle('scrolled', window.scrollY > 50);
      });

      // Mobile menu
      const menuToggle  = document.getElementById('menu-toggle');
      const mobileMenu  = document.getElementById('mobile-menu');
      menuToggle?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', String(mobileMenu?.classList.contains('open')));
      });

      // Mobile menu resize listener to close it when going desktop
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
          mobileMenu?.classList.remove('open');
          menuToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // Global reveals
      const reveals: [string, Record<string,unknown>][] = [
        ['.reveal',       { opacity:1, y:0 }],
        ['.reveal-left',  { opacity:1, x:0 }],
        ['.reveal-right', { opacity:1, x:0 }],
        ['.reveal-scale', { opacity:1, scale:1 }],
      ];
      reveals.forEach(([sel, to]) => {
        gsap.utils.toArray(sel).forEach((el: any) => {
          gsap.to(el, {
            ...to, duration:0.9, ease:'power3.out',
            scrollTrigger:{ trigger:el, start:'top 88%', once:true }
          });
        });
      });

      // Globals
      (window as any).closeMobileMenu = () => mobileMenu?.classList.remove('open');
    </script>
  </body>
</html>
