---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto y Reservas | Country Licores Barranquilla"
  description="Reserva tu mesa en Country Licores Barranquilla. Más de 20 años de trayectoria. Escríbenos al WhatsApp 324 303 7861. Carrera 43B #82-19. Horario: 4pm - 3:30am."
  canonical="https://countrylicores.com/contacto"
>
  <!-- Page Hero -->
  <section style="padding:10rem 0 5rem; background:#0A0305; position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; background:radial-gradient(ellipse at 60% 50%, rgba(123,24,40,0.08) 0%, transparent 60%); pointer-events:none;"></div>
    <div class="container" style="position:relative; text-align:center;">
      <p class="section-eyebrow" style="justify-content:center;">Estamos para ti</p>
      <h1 class="font-display" style="font-size:clamp(2.2rem, 5vw, 4rem); font-weight:900; color:#FFFFFF; margin-top:0.5rem; margin-bottom:1rem; line-height:1.1;">
        Contacto y<br/>
        <span class="gold-text-gradient">Reservas</span>
      </h1>
      <p style="color:#C8BFB0; max-width:500px; margin:0 auto; font-size:1rem; line-height:1.75;">
        Un mensaje es todo lo que necesitas. Te respondemos rápido y aseguramos tu espacio.
      </p>
    </div>
  </section>

  <!-- ========================================
       FORMULARIO + INFO
       ======================================== -->
  <section style="background:#0A0305; padding:5rem 0 7rem;">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 1.1fr; gap:5rem; align-items:start;">

        <!-- Contact Info -->
        <div class="reveal-left">
          <h2 class="font-display" style="font-size:1.6rem; font-weight:700; color:#FFFFFF; margin-bottom:2rem;">
            Información de<br/>
            <span class="gold-text-gradient">contacto</span>
          </h2>

          <!-- WhatsApp -->
          <a href="https://wa.link/ar1xqp" title="WhatsApp Country Licores" target="_blank" rel="noopener"
            style="display:flex; align-items:center; gap:1.25rem; padding:1.5rem; border:1px solid rgba(123,24,40,0.25); margin-bottom:1rem; transition:border-color 0.3s ease, background 0.3s ease;"
            onmouseover="this.style.borderColor='rgba(201,168,76,0.4)'; this.style.background='rgba(123,24,40,0.06)'"
            onmouseout="this.style.borderColor='rgba(123,24,40,0.25)'; this.style.background='transparent'"
          >
            <div style="width:48px; height:48px; background:rgba(37,211,102,0.1); border:1px solid rgba(37,211,102,0.3); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#25D366">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <div style="font-size:0.7rem; letter-spacing:0.15em; text-transform:uppercase; color:#25D366; margin-bottom:0.25rem;">WhatsApp</div>
              <div style="font-size:1.05rem; font-weight:600; color:#FFFFFF;">+57 324 303 7861</div>
              <div style="font-size:0.8rem; color:#C8BFB0; margin-top:0.1rem;">Respuesta en minutos</div>
            </div>
          </a>

          <!-- Teléfono -->
          <a href="tel:+573243037861" title="Llamar a Country Licores"
            style="display:flex; align-items:center; gap:1.25rem; padding:1.5rem; border:1px solid rgba(123,24,40,0.25); margin-bottom:1rem; transition:border-color 0.3s ease, background 0.3s ease;"
            onmouseover="this.style.borderColor='rgba(201,168,76,0.4)'; this.style.background='rgba(123,24,40,0.06)'"
            onmouseout="this.style.borderColor='rgba(123,24,40,0.25)'; this.style.background='transparent'"
          >
            <div style="width:48px; height:48px; background:rgba(201,168,76,0.1); border:1px solid rgba(201,168,76,0.3); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.61 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.91 5.91l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <div style="font-size:0.7rem; letter-spacing:0.15em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.25rem;">Teléfono</div>
              <div style="font-size:1.05rem; font-weight:600; color:#FFFFFF;">324 303 7861</div>
            </div>
          </a>

          <!-- Instagram -->
          <a href="https://www.instagram.com/countrylicores" title="Country Licores en Instagram" target="_blank" rel="noopener"
            style="display:flex; align-items:center; gap:1.25rem; padding:1.5rem; border:1px solid rgba(123,24,40,0.25); margin-bottom:2rem; transition:border-color 0.3s ease, background 0.3s ease;"
            onmouseover="this.style.borderColor='rgba(201,168,76,0.4)'; this.style.background='rgba(123,24,40,0.06)'"
            onmouseout="this.style.borderColor='rgba(123,24,40,0.25)'; this.style.background='transparent'"
          >
            <div style="width:48px; height:48px; background:rgba(193,53,132,0.1); border:1px solid rgba(193,53,132,0.3); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#C13584">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <div style="font-size:0.7rem; letter-spacing:0.15em; text-transform:uppercase; color:#C13584; margin-bottom:0.25rem;">Instagram</div>
              <div style="font-size:1.05rem; font-weight:600; color:#FFFFFF;">@countrylicores</div>
            </div>
          </a>

          <!-- Sede Única -->
          <div style="margin-bottom:2rem;">
            <h3 style="font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A84C; margin-bottom:1.25rem;">Nuestra Sede</h3>
            <div style="padding:1.25rem; border:1px solid rgba(123,24,40,0.3); background:rgba(123,24,40,0.05);">
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#C9A84C;">Sede Principal — Calle 82</span>
              </div>
              <p style="color:#C8BFB0; font-size:0.88rem; line-height:1.6;">Carrera 43B #82-19, Barranquilla, Atlántico</p>
            </div>
          </div>

          <!-- Horario -->
          <div style="padding:1.25rem; border:1px solid rgba(201,168,76,0.15); background:rgba(201,168,76,0.03);">
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#C9A84C;">Horario de Atención</span>
            </div>
            <p style="color:#FFFFFF; font-size:0.95rem; font-weight:600;">Lunes a Domingo</p>
            <p style="color:#C9A84C; font-size:1.05rem; font-weight:700;">4:00 p.m. — 3:30 a.m.</p>
          </div>
        </div>

        <!-- Form -->
        <div class="reveal-right">
          <div style="padding:2.5rem; border:1px solid rgba(123,24,40,0.25); background:#130608;">
            <h2 class="font-display" style="font-size:1.6rem; font-weight:700; color:#FFFFFF; margin-bottom:0.5rem;">
              Solicita tu reserva
            </h2>
            <p style="color:#C8BFB0; font-size:0.88rem; margin-bottom:2rem;">
              Completa el formulario y te contactamos en minutos.
            </p>

            <form id="reserva-form" style="display:flex; flex-direction:column; gap:1.25rem;" onsubmit="handleFormSubmit(event)">
              <div>
                <label for="nombre" style="display:block; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.5rem;">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required
                  style="width:100%; padding:0.875rem 1rem; background:#1A0A0D; border:1px solid rgba(201,168,76,0.2); color:#F8F4EF; font-family:var(--font-body); font-size:0.9rem; outline:none; transition:border-color 0.3s;"
                  onfocus="this.style.borderColor='rgba(201,168,76,0.6)'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"
                />
              </div>

              <div>
                <label for="telefono" style="display:block; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.5rem;">WhatsApp o teléfono *</label>
                <input type="tel" id="telefono" name="telefono" placeholder="+57 300 000 0000" required
                  style="width:100%; padding:0.875rem 1rem; background:#1A0A0D; border:1px solid rgba(201,168,76,0.2); color:#F8F4EF; font-family:var(--font-body); font-size:0.9rem; outline:none; transition:border-color 0.3s;"
                  onfocus="this.style.borderColor='rgba(201,168,76,0.6)'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"
                />
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div>
                  <label for="fecha" style="display:block; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.5rem;">Fecha *</label>
                  <input type="date" id="fecha" name="fecha" required
                    style="width:100%; padding:0.875rem 1rem; background:#1A0A0D; border:1px solid rgba(201,168,76,0.2); color:#F8F4EF; font-family:var(--font-body); font-size:0.9rem; outline:none; color-scheme:dark; transition:border-color 0.3s;"
                    onfocus="this.style.borderColor='rgba(201,168,76,0.6)'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"
                  />
                </div>
                <div>
                  <label for="personas" style="display:block; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.5rem;">Personas *</label>
                  <input type="number" id="personas" name="personas" min="1" max="100" placeholder="¿Cuántos?" required
                    style="width:100%; padding:0.875rem 1rem; background:#1A0A0D; border:1px solid rgba(201,168,76,0.2); color:#F8F4EF; font-family:var(--font-body); font-size:0.9rem; outline:none; transition:border-color 0.3s;"
                    onfocus="this.style.borderColor='rgba(201,168,76,0.6)'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"
                  />
                </div>
              </div>

              <div>
                <label for="mensaje" style="display:block; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C9A84C; margin-bottom:0.5rem;">Mensaje adicional</label>
                <textarea id="mensaje" name="mensaje" rows="3" placeholder="¿Es un cumpleaños? ¿Tienes alguna petición especial?"
                  style="width:100%; padding:0.875rem 1rem; background:#1A0A0D; border:1px solid rgba(201,168,76,0.2); color:#F8F4EF; font-family:var(--font-body); font-size:0.9rem; outline:none; resize:vertical; min-height:80px; transition:border-color 0.3s;"
                  onfocus="this.style.borderColor='rgba(201,168,76,0.6)'" onblur="this.style.borderColor='rgba(201,168,76,0.2)'"
                ></textarea>
              </div>

              <button type="submit" id="form-submit" class="btn-primary" style="width:100%; justify-content:center; font-size:0.95rem; padding:1rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <span>Enviar por WhatsApp</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function handleFormSubmit(e: Event) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const nombre   = (form.querySelector('#nombre')   as HTMLInputElement).value;
      const telefono = (form.querySelector('#telefono')  as HTMLInputElement).value;
      const fecha    = (form.querySelector('#fecha')     as HTMLInputElement).value;
      const personas = (form.querySelector('#personas')  as HTMLInputElement).value;
      const mensaje  = (form.querySelector('#mensaje')   as HTMLTextAreaElement).value;

      const text = encodeURIComponent(
        `Hola Country Licores! Quiero hacer una reserva:\n\n` +
        `*Nombre:* ${nombre}\n` +
        `*Teléfono:* ${telefono}\n` +
        `*Sede:* Carrera 43B #82-19\n` +
        `*Fecha:* ${fecha}\n` +
        `*Personas:* ${personas}\n` +
        (mensaje ? `*Mensaje:* ${mensaje}` : '')
      );

      window.open(`https://wa.me/573243037861?text=${text}`, '_blank');
    }

    (window as any).handleFormSubmit = handleFormSubmit;
  </script>
</Layout>
