---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroBarImg from "../assets/hero-bar.jpg";
---

<Layout
  title="Bar Vallenato en Barranquilla | Country Licores — Donde el Vallenato se Siente"
  description="Country Licores: más de 20 años siendo el mejor bar vallenato de Barranquilla. Reservas de mesa, paquetes de cumpleaños y parranda auténtica en la Carrera 43B #82-19. Llámanos: 324 303 7861."
  canonical="https://countrylicores.com/"
>
  <!-- ========================================
       HERO
       ======================================== -->
  <section
    id="hero"
    style="
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:radial-gradient(circle, rgba(58,8,16,0.45) 0%, rgba(10,10,10,1) 75%);
  "
  >
    <!-- Background -->
    <div style="position:absolute; inset:0; z-index:0;">
      <Image
        src={heroBarImg}
        alt="Ambiente nocturno en Country Licores Barranquilla"
        title="Country Licores — Bar Vallenato Barranquilla"
        loading="eager"
        style="width:100%; height:100%; object-fit:cover; object-position:center; opacity:0.25;"
      />
      <div
        style="position:absolute; inset:0; background:linear-gradient(to right, rgba(10,10,10,0.93) 40%, rgba(10,10,10,0.55) 100%);"
      >
      </div>
      <div
        style="position:absolute; inset:0; background:linear-gradient(to top, rgba(10,10,10,0.92) 0%, transparent 55%);"
      >
      </div>
    </div>

    <!-- Glows -->
    <div
      class="hero-bg-glow"
      style="background:radial-gradient(circle, rgba(123,24,40,0.5) 0%, transparent 70%); top:-80px; left:-80px; z-index:1;"
    >
    </div>
    <div
      class="hero-bg-glow"
      style="background:radial-gradient(circle, rgba(123,24,40,0.15) 0%, transparent 70%); bottom:0; right:8%; z-index:1;"
    >
    </div>

    <!-- Vinotinto accent stripe -->
    <div
      style="position:absolute; left:0; top:0; bottom:0; width:4px; background:linear-gradient(to bottom, transparent, #7B1828, transparent); z-index:2;"
    >
    </div>

    <!-- Content -->
    <div
      class="container"
      style="position:relative; z-index:2; padding-top:8rem; padding-bottom:6rem;"
    >
      <div style="max-width:680px;">
        <p
          id="hero-eyebrow"
          class="section-eyebrow hero-animate hero-animate-1"
        >
          Vallenato y algo más
        </p>

        <h1
          id="hero-title"
          class="font-display hero-animate hero-animate-2"
          style="
            font-size:clamp(2.8rem, 7vw, 5.5rem);
            font-weight:900;
            line-height:1.05;
            color:#FFFFFF;
            margin-bottom:1.5rem;
          "
        >
          Donde <span class="vinotinto-text-gradient">El Vallenato</span><br />
          se siente
        </h1>

        <p
          id="hero-sub"
          class="hero-animate hero-animate-3 text-neutral-300"
          style="
          font-size:clamp(1rem, 2vw, 1.2rem);
          line-height:1.8;
          margin-bottom:2.5rem;
          max-width:520px;
        "
        >
          Donde la parranda es auténtica, el vallenato se siente y cada noche se
          convierte en un recuerdo. Más de dos décadas siendo el alma de la
          rumba barranquillera.
        </p>

        <div
          id="hero-ctas"
          class="hero-animate hero-animate-4"
          style="display:flex; flex-wrap:wrap; gap:1rem;"
        >
          <a
            href="/contacto"
            title="Reservar mesa en Country Licores vía WhatsApp"
            target="_blank"
            rel="noopener"
            class="btn-primary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            <span>Reservar Mesa</span>
          </a>
          <a
            href="/servicios"
            title="Ver servicios de Country Licores"
            class="btn-secondary"
          >
            <span>Ver Servicios</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
          </a>
        </div>

        <!-- Stats -->
        <div
          id="hero-stats"
          class="hero-animate hero-animate-5"
          style="
          display:flex; flex-wrap:wrap; gap:2.5rem;
          margin-top:4rem; padding-top:2.5rem;
          border-top:1px solid rgba(255,255,255,0.1);
        "
        >
          {
            [
              { val: "20+", label: "Años de parranda" },
              { val: "+7K", label: "Seguidores en IG" },
              { val: "+3.9K", label: "Noches documentadas" },
              { val: "24/7", label: "Atención al cliente" },
            ].map((s) => (
              <div>
                <div
                  class="font-accent"
                  style="font-size:2.2rem; color:#FFFFFF; line-height:1;"
                >
                  {s.val}
                </div>
                <div style="font-size:0.78rem; letter-spacing:0.1em; text-transform:uppercase; color:#999999; margin-top:0.25rem;">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      style="position:absolute; bottom:2rem; left:50%; transform:translateX(-50%); z-index:2; display:flex; flex-direction:column; align-items:center; gap:0.5rem;"
    >
      <div
        style="font-size:0.65rem; letter-spacing:0.2em; text-transform:uppercase; color:#999999;"
      >
        Desliza
      </div>
      <div
        id="scroll-indicator"
        style="width:1px; height:40px; background:linear-gradient(to bottom, #7B1828, transparent);"
      >
      </div>
    </div>
  </section>

  <!-- ========================================
       TRUST SECTION
       ======================================== -->
  <section
    class="bg-nocturno-bg"
    style="padding:5rem 0; border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
        <p class="section-eyebrow" style="justify-content:center;">
          Por qué elegirnos
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem;"
        >
          Más de 20 años de parranda<br />
          <span class="vinotinto-text-gradient">auténtica en Barranquilla</span>
        </h2>
      </div>

      <!-- Trust cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {
          [
            {
              icon: `<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>`,
              title: "Ambiente Auténtico",
              desc: "Vallenato, popular y ranchera. La parranda costeña que buscas, sin pretensiones ni artificios.",
            },
            {
              icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
              title: "Grupos y Eventos",
              desc: "Paquetes especiales para cumpleaños, despedidas y reuniones. Reserva tu espacio y llegamos listos.",
            },
            {
              icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
              title: "Horario Extendido",
              desc: "4:00 p.m. hasta las 3:30 a.m. La noche dura lo que tiene que durar.",
            },
            {
              icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
              title: "20+ Años de Confianza",
              desc: "Dos décadas siendo el referente de la rumba vallenata en Barranquilla. Una trayectoria que habla sola.",
            },
          ].map((c) => (
            <div
              class="card-dark reveal"
              style="padding:2rem; text-align:center;"
            >
              <div style="width:52px; height:52px; background:rgba(123,24,40,0.15); border:1px solid rgba(123,24,40,0.35); display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem;">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#9E2235"
                  stroke-width="1.5"
                  set:html={c.icon}
                />
              </div>
              <h3 style="font-size:1.05rem; font-weight:700; color:#FFFFFF; margin-bottom:0.5rem;">
                {c.title}
              </h3>
              <p class="text-neutral-300" style="font-size:0.88rem; line-height:1.7;">
                {c.desc}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Testimonials -->
      <div class="reveal" style="margin-bottom:1rem; text-align:center;">
        <p class="section-eyebrow" style="justify-content:center;">
          Lo que dicen nuestros clientes
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              init: "M",
              name: "María González",
              role: "Cliente frecuente",
              text: "El mejor lugar para pasar una noche de vallenato en Barranquilla. El ambiente es increíble y la atención de primera. Siempre volvemos.",
            },
            {
              init: "C",
              name: "Carolina Herrera",
              role: "Evento de cumpleaños",
              text: "Celebramos el cumpleaños de mi esposo aquí y fue espectacular. El paquete incluía todo y el vallenato sonó toda la noche.",
            },
            {
              init: "R",
              name: "Roberto Díaz",
              role: "Habitué",
              text: "Country Licores tiene ese sabor a parranda genuina que no se encuentra en cualquier lado. Ya somos de la familia.",
            },
          ].map((t) => (
            <div class="card-dark reveal" style="padding:1.75rem;">
              <div style="display:flex; gap:0.25rem; margin-bottom:1rem;">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="#9E2235"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>
              <p class="text-neutral-300" style="font-size:0.9rem; line-height:1.75; font-style:italic; margin-bottom:1.25rem;">
                "{t.text}"
              </p>
              <div style="display:flex; align-items:center; gap:0.75rem;">
                <div style="width:36px; height:36px; background:#7B1828; display:flex; align-items:center; justify-content:center; font-weight:700; color:#FFFFFF; font-size:0.85rem;">
                  {t.init}
                </div>
                <div>
                  <div style="font-size:0.88rem; font-weight:600; color:#FFFFFF;">
                    {t.name}
                  </div>
                  <div style="font-size:0.75rem; color:#999999;">{t.role}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICES SECTION
       ======================================== -->
  <section class="bg-nocturno-bg" style="padding:6rem 0;">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom:4rem;">
        <p class="section-eyebrow" style="justify-content:center;">
          Lo que ofrecemos
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:700; color:#FFFFFF; margin-top:0.5rem; margin-bottom:1rem;"
        >
          Servicios pensados para<br />
          <span class="vinotinto-text-gradient">tu mejor noche</span>
        </h2>
        <p
          style="color:#999999; max-width:520px; margin:0 auto; font-size:1rem; line-height:1.7;"
        >
          Desde una salida casual hasta el evento del año. En Country Licores
          tenemos el plan perfecto para ti.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Reserva de Mesa -->
        <div
          class="card-dark reveal"
          style="padding:2.5rem; position:relative; overflow:hidden;"
        >
          <div
            style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, #7B1828, transparent);"
          >
          </div>
          <div
            style="display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; border:1px solid rgba(123,24,40,0.4); margin-bottom:1.5rem;"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#9E2235"
              stroke-width="1.5"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
              ></path><polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h3
            class="font-display"
            style="font-size:1.3rem; font-weight:700; color:#FFFFFF; margin-bottom:0.75rem;"
          >
            Reserva de Mesa
          </h3>
          <p
            style="color:#999999; font-size:0.9rem; line-height:1.75; margin-bottom:1.5rem;"
          >
            Asegura tu espacio antes de llegar. Tu mesa te espera lista para la
            parranda — sin esperas, sin sorpresas.
          </p>
          <ul
            style="list-style:none; display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1.5rem;"
          >
            {
              [
                "Mesa garantizada",
                "Sin esperas",
                "Atención prioritaria",
                "Cualquier día de la semana",
              ].map((i) => (
                <li style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:#999999;">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#7B1828"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {i}
                </li>
              ))
            }
          </ul>
          <a
            href="/servicios"
            title="Más sobre reservas en Country Licores"
            class="btn-secondary"
            style="font-size:0.8rem; padding:0.6rem 1.4rem;"
            ><span>Ver detalles</span></a
          >
        </div>

        <!-- Paquete Cumpleaños -->
        <div
          class="card-dark border-vinotinto-light reveal"
          style="padding:2.5rem; position:relative; overflow:hidden;"
        >
          <div
            style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, var(--color-vinotinto-dark), var(--color-vinotinto-light));"
          >
          </div>
          <div
            style="display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; background:linear-gradient(135deg, var(--color-vinotinto-dark), var(--color-vinotinto-light)); margin-bottom:1.5rem;"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FFFFFF"
              stroke-width="1.5"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle
                cx="12"
                cy="7"
                r="4"></circle>
            </svg>
          </div>
          <div style="position:absolute; top:1.5rem; right:1.5rem;">
            <span
              class="bg-vinotinto text-white"
              style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; padding:0.25rem 0.6rem; border:1px solid var(--color-vinotinto-light);"
              >Popular</span
            >
          </div>
          <h3
            class="font-display"
            style="font-size:1.3rem; font-weight:700; color:#FFFFFF; margin-bottom:0.75rem;"
          >
            Paquete Cumpleaños
          </h3>
          <p
            style="color:#999999; font-size:0.9rem; line-height:1.75; margin-bottom:1.5rem;"
          >
            Celebra como se merece. Paquetes todo incluido para que el
            cumpleañero viva una noche inolvidable.
          </p>
          <ul
            style="list-style:none; display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1.5rem;"
          >
            {
              [
                "Mesa decorada",
                "Botella incluida",
                "Picadas",
                "Sorpresa especial",
                "Atención personalizada",
              ].map((i) => (
                <li style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:#999999;">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#7B1828"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {i}
                </li>
              ))
            }
          </ul>
          <a
            href="/contacto"
            title="Reservar paquete de cumpleaños"
            target="_blank"
            rel="noopener"
            class="btn-primary"
            style="font-size:0.8rem; padding:0.7rem 1.4rem;"
            ><span>Reservar ahora</span></a
          >
        </div>

        <!-- Ambiente Vallenato -->
        <div
          class="card-dark reveal"
          style="padding:2.5rem; position:relative; overflow:hidden;"
        >
          <div
            style="position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, #7B1828, transparent);"
          >
          </div>
          <div
            style="display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; border:1px solid rgba(123,24,40,0.5); margin-bottom:1.5rem;"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#9E2235"
              stroke-width="1.5"
            >
              <path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"
              ></circle><circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
          <h3
            class="font-display"
            style="font-size:1.3rem; font-weight:700; color:#FFFFFF; margin-bottom:0.75rem;"
          >
            Ambiente Vallenato
          </h3>
          <p
            style="color:#999999; font-size:0.9rem; line-height:1.75; margin-bottom:1.5rem;"
          >
            Vallenato clásico y moderno, popular y ranchera. El sonido que mueve
            el alma costeña, noche tras noche.
          </p>
          <ul
            style="list-style:none; display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1.5rem;"
          >
            {
              [
                "Vallenato clásico y moderno",
                "Música popular",
                "Rancheras",
                "Crossover costeño",
              ].map((i) => (
                <li style="display:flex; align-items:center; gap:0.5rem; font-size:0.85rem; color:#999999;">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#7B1828"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {i}
                </li>
              ))
            }
          </ul>
          <a
            href="/nosotros"
            title="Conoce nuestra historia"
            class="btn-secondary"
            style="font-size:0.8rem; padding:0.6rem 1.4rem;"
            ><span>Nuestra historia</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       CTA SECTION
       ======================================== -->
  <section
    class="bg-nocturno-bg"
    style="position:relative; padding:7rem 0; overflow:hidden; border-top:1px solid var(--color-vinotinto-dark);"
  >
    <div
      style="position:absolute; inset:0; background:linear-gradient(135deg, rgba(123,24,40,0.2) 0%, rgba(255,255,255,0.02) 50%, transparent 100%);"
    >
    </div>
    <div
      style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:100%; max-width:700px; aspect-ratio:1/1; background:radial-gradient(circle, rgba(123,24,40,0.08) 0%, transparent 70%); border-radius:50%; pointer-events:none;"
    >
    </div>
    <div class="container" style="position:relative; text-align:center;">
      <div class="reveal">
        <p
          class="section-eyebrow"
          style="justify-content:center; margin-bottom:1rem;"
        >
          Tu próxima noche te espera
        </p>
        <h2
          class="font-display"
          style="font-size:clamp(2rem, 5vw, 3.5rem); font-weight:900; color:#FFFFFF; margin-bottom:1rem; line-height:1.1;"
        >
          La mesa está puesta.<br />
          <span class="vinotinto-text-gradient">¿Vamos a parrandear?</span>
        </h2>
        <p
          style="color:#999999; font-size:1rem; line-height:1.7; max-width:500px; margin:0 auto 2.5rem;"
        >
          Escríbenos por WhatsApp y aseguramos tu noche, tu cumpleaños o tu
          evento especial en Country Licores.
        </p>
        <div
